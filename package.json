{
  "name": "rent-receipt-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first rent receipt generator for HRA. Everything happens in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "spike:node": "node spike/node-run.ts",
    "spike:build": "vite build --config spike/vite.spike.config.ts",
    "fonts": "node scripts/subset-fonts.ts",
    "test:e2e": "playwright test",
    "og": "node scripts/og-image.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@libpdf/core": "0.5.3",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.1",
    "jspdf": "4.2.1",
    "pdf-lib": "1.17.1",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
